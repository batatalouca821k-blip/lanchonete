# ---- Servidor ----
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:5173

# ---- PostgreSQL / Supabase ----
# Use DATABASE_URL ou informe DB_HOST, DB_PORT, DB_USER, DB_PASSWORD e DB_NAME.
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres_dev
DB_NAME=lanchonete
DB_SSL=false
# Optional CA certificate path, relative to backend, for verified Supabase TLS connections.
DB_SSL_CA_FILE=
DB_POOL_SIZE=10

# Connection string de um banco PostgreSQL local e separado, usado apenas pelos testes.
TEST_DATABASE_URL=

# ---- Sessão / administrador inicial ----
SESSION_HOURS=12
ADMIN_EMAIL=admin@tokenpedidos.com
ADMIN_PASSWORD=

# ---- Fuso horário dos filtros/relatórios ----
APP_TIMEZONE=America/Sao_Paulo
APP_UTC_OFFSET=-03:00

# ---- Pix estático ----
PIX_KEY=pix@tokenpedidos.com
PIX_MERCHANT_NAME=LANCHONETE BOCA CHEIA
PIX_CITY=SAO PAULO
PIX_EXPIRATION_MINUTES=30

# ---- Mercado Pago (opcional) ----
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ---- E-mail (opcional) ----
# Gmail: use uma senha de app do Google, nunca a senha normal da conta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
